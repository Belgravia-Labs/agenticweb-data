{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"array",
 "items":{"type":"object","required":["id","name","url","kind","does","covers","last_checked"],"additionalProperties":false,
  "properties":{"id":{"type":"string","pattern":"^[a-z0-9-]+$"},"name":{"type":"string","minLength":1},
   "url":{"type":"string","pattern":"^https?://"},
   "kind":{"enum":["scanner","registry","index","tracker","standards-body","docs","tool"]},
   "does":{"type":"string","minLength":10},
   "covers":{"type":"array","items":{"type":"string"}},
   "last_checked":{"type":"string","pattern":"^\\d{4}-\\d{2}-\\d{2}$"}}}}

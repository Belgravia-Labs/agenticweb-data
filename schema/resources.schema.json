{"$schema":"https://json-schema.org/draft/2020-12/schema","type":"object",
 "additionalProperties":{"type":"object","required":["implementations","sdks","validators","registries","adopters"],
  "additionalProperties":false,
  "properties":{"implementations":{"$ref":"#/$defs/list"},"sdks":{"$ref":"#/$defs/list"},"validators":{"$ref":"#/$defs/list"},
   "registries":{"$ref":"#/$defs/list"},"adopters":{"$ref":"#/$defs/list"}}},
 "$defs":{"list":{"type":"array","items":{"type":"object","required":["name","url","date","evidence"],
   "properties":{"name":{"type":"string"},"url":{"type":"string","pattern":"^https?://"},"date":{"type":["string","null"]},"evidence":{"type":"string"},"note":{"type":"string"}}}}}}
